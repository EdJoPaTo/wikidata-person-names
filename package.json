{
	"name": "wikidata-person-names",
	"version": "1.3.0",
	"description": "Set of given and last names pulled from Wikidata",
	"keywords": [
		"data",
		"dataset",
		"datasets",
		"family",
		"female",
		"first",
		"firstname",
		"given",
		"human",
		"last",
		"lastname",
		"male",
		"name",
		"names",
		"people",
		"person",
		"personal",
		"sample",
		"unisex",
		"wikidata"
	],
	"license": "MIT",
	"author": {
		"name": "EdJoPaTo",
		"email": "wikidata-person-names-npm-package@edjopato.de",
		"url": "https://edjopato.de"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EdJoPaTo/wikidata-person-names.git"
	},
	"files": [
		"index.*js",
		"index.d.ts"
	],
	"type": "module",
	"main": "./index.js",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js"
		}
	},
	"scripts": {
		"build": "./build.sh",
		"prepack": "npm run build",
		"update-names": "node update-names.ts",
		"test": "tsc && oxlint && oxfmt --check"
	},
	"devDependencies": {
		"@types/node": "^18.19.130",
		"oxfmt": "^0.76.0",
		"oxlint": "^1.91.0",
		"oxlint-tsgolint": "^7.0.2006",
		"typescript": "^7.0.2",
		"wikibase-sdk": "^9.2.5"
	},
	"engines": {
		"node": ">=12"
	}
}
